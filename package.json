    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@compodoc/compodoc": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@fortawesome/angular-fontawesome": {
      "@angular/core": "$@angular/core"
    }
