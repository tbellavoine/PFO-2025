NODE_ENV=development
PORT=3000

# Postgres. In production this points at the Supabase connection string
# (Settings > Database > Connection string, "Transaction" pooler mode);
# locally it points at the docker-compose Postgres (see docs/plan-dynamic-backend.md).
DATABASE_URL=postgresql://pfo:pfo_dev_password@localhost:55432/pfo2025
DATABASE_SSL=false

# Local disk storage for uploaded project preview images (decision: §2.4 of the plan).
MEDIA_UPLOAD_DIR=./uploads
MEDIA_PUBLIC_URL=http://localhost:3000/media

# Single admin identity (no open registration). Generate the hash with:
#   node -e "require('argon2').hash(process.argv[1]).then(console.log)" 'your-password'
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:4200
